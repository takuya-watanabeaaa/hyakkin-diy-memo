# Public site origin (no trailing slash). Canonical / OG URLs use this.
# 本番（Vercel）例: https://hyakkin-diy-prod.vercel.app
NEXT_PUBLIC_SITE_URL=https://hyakkin-diy-prod.vercel.app

# ── Python アフィリエイト記事ツール（tools/affiliate）用 ──
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AMAZON_ASSOCIATE_TAG=your-assoc-tag-22
# （記事ページの YouTube 向け「上位互換を探す」Amazon 検索リンクにも使用）
# 楽天アフィリエイト ID（記録用・テンプレがフル URL なら未設定でも可）
# RAKUTEN_AFFILIATE_ID=
# サイトヘッダー下の横長「楽天市場」バナー（HGC）に使用（Next が .env を読込）。
# 任意: 管理画面のバナー「画像アドレス」直 URL（.png / .jpg / .gif 等。HTML 丸ごとは不可）
# 表示は左に小さなサムネ程度。壊れている URL は自動で隠れ、テキストバナーのみになります。
# RAKUTEN_AFFILIATE_BANNER_IMAGE=
# バナー全体のリンクを固定したい場合（未設定時は ID から楽天市場トップの HGC を生成）
# RAKUTEN_AFFILIATE_BANNER_LINK=
# RAKUTEN_AFFILIATE_BANNER_ALT=楽天市場でお買い物
# 楽天: テンプレ未設定時、上記 ID だけで市場検索向け HGC リンク（hb.afl…）を自動生成します。
# 任意で上書き: hb.afl 等のテンプレ。{keyword}=quote 済み、{raw_keyword}=検索語そのまま
# RAKUTEN_SEARCH_LINK_TEMPLATE=https://hb.afl.rakuten.co.jp/...&pc={keyword}
# A8: 案件ごとのベース URL。例: "...&body={keyword}" または raw 用に {raw_keyword}
# A8_LINK_TEMPLATE=https://px.a8.net/svt/ejp?a8mat=...&body={keyword}
# 別案件用の第2テンプレ（search_keywords.a8_template=alt または正規表現一致時に使用）
# A8_LINK_TEMPLATE_ALT=
# Amazon/楽天キーワードにこの正規表現がマッチすると A8 に ALT テンプレを使う（任意）
# A8_ALT_KEYWORD_REGEX=
# 出力先を固定する場合（未設定時はリポジトリの content/affiliate）
# AFFILIATE_CONTENT_DIR=
# AFFILIATE_MAX_PRODUCTS=8
# AFFILIATE_MAX_SOURCE_CHARS=14000
# main.py を content/affiliate に書いて manifest 更新（チャンネル監視からも有効）
# AFFILIATE_PIPELINE_PUBLISH_SITE=1

# ── YouTube チャンネル新着チェック（tools/affiliate/channel_watch.py） ──
# Google Cloud で Data API v3 を有効にし、API キーを発行してください。
# YOUTUBE_API_KEY=
# チャンネル URL の UC で始まる ID（例: https://www.youtube.com/channel/UCxxxx → UCxxxx）
# YOUTUBE_CHANNEL_ID=

# ── affiliate_tool --git-commit-push 用（任意） ──
# GIT_REMOTE=origin
